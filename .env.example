# ============================================================
# Spin the Bottle / Целуй и Знакомься
# Скопируйте файл как .env и заполните реальными значениями
# ============================================================
NODE_ENV=development

# ===== PostgreSQL =====
DATABASE_URL="postgresql://spinthe:spinthe_secret@localhost:5432/spinthe?schema=public"
POSTGRES_USER=spinthe
POSTGRES_PASSWORD=spinthe_secret
POSTGRES_DB=spinthe
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# ===== Backend =====
SERVER_PORT=3000
# ОБЯЗАТЕЛЬНО замените на длинную случайную строку в продакшене!
JWT_SECRET="dev-jwt-secret-change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="*"

# ===== Telegram Bot =====
# 1. Откройте @BotFather в Telegram
# 2. /newbot → получите токен вида "123456789:ABCdef..."
# 3. /setmenubutton → прикрепите Mini App
# 4. /newapp → создайте Web App, указав URL вашего приложения
BOT_TOKEN="0000000000:AAExampleTokenFromBotFatherHere-xxxx"
BOT_USERNAME="spinthe_bot"
# Опубликуйте приложение, потом укажите его URL
WEBAPP_URL="https://your-domain.com"

# ===== Порты для docker-compose =====
SERVER_PORT=3000
WEB_PORT=8080

# ===== Frontend (Vite — префикс VITE_ обязателен!) =====
VITE_API_URL="http://localhost:3000/api"
VITE_WS_URL=""
VITE_BOT_NAME="spinthe_bot"
VITE_APP_NAME="Целуй и Знакомься"
