# ============================================================
# Backend server Dockerfile (build from repo ROOT!)
#   docker build -f Dockerfile.server -t spinthe-server .
# ============================================================
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/server/package.json ./packages/server/

RUN npm install --workspace=@spinthe/shared --workspace=@spinthe/server

COPY packages/shared ./packages/shared
COPY packages/server ./packages/server

# Генерируем Prisma client и собираем TS
RUN npx prisma generate --schema=./packages/server/prisma/schema.prisma
RUN npm run build -w @spinthe/server

# ============== Production ==============
FROM node:20-alpine AS production

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/server/package.json ./packages/server/

# Ставим prod-зависимости + prisma для миграций
RUN npm install --omit=dev --workspace=@spinthe/shared --workspace=@spinthe/server \
  && cd packages/server && npm install prisma@5.19.0 --no-save

COPY --from=builder /app/packages/server/dist ./packages/server/dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY packages/server/prisma ./packages/server/prisma
COPY packages/shared ./packages/shared

EXPOSE 3000
WORKDIR /app/packages/server
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/index.js"]
